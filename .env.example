# Canonical site URL (sitemap, Open Graph, JSON-LD). Required in production.
# On Vercel, falls back to VERCEL_URL (injected by the platform) if unset.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Which folder under content/ is the source for all posts: pt-BR | en
# CONTENT_SOURCE_LOCALE=pt-BR

# Optional: OpenAI for cross-locale translation (otherwise MyMemory)
# OPENAI_API_KEY=

# Optional: model id when using OpenAI (default: gpt-4o-mini)
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
